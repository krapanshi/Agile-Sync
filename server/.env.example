NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Use the Atlas database user, not the Atlas website login.
# Percent-encode special characters in credentials. Never commit real credentials.
MONGODB_URI=mongodb+srv://<database-user>:<encoded-password>@<cluster-host>/agile_sync?retryWrites=true&w=majority
APP_ORIGIN=http://localhost:5173

